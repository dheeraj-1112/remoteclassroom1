FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DJANGO_DEBUG=false

WORKDIR /app
COPY requirements-render.txt ./requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt \
    && python -m nltk.downloader punkt punkt_tab stopwords

COPY . .
RUN mkdir -p /app/staticfiles
EXPOSE 10000
CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py collectstatic --noinput && python manage.py bootstrap_render_users && gunicorn config.wsgi:application --bind 0.0.0.0:${PORT:-10000} --workers 1 --threads 4 --timeout 100"]
