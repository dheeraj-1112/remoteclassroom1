# Copy this file to .env for local development.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
TIME_ZONE=Asia/Kolkata

DB_NAME=remote_classroom
DB_USER=remote_classroom
DB_PASSWORD=local-dev-only-change-me
DB_HOST=db
DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
WHISPER_MODEL=base
WHISPER_LANGUAGE=
MAX_LECTURE_UPLOAD_MB=1024
DEMO_PASSWORD=DemoOnlyChange123!

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
VITE_API_URL=http://localhost:8000/api

# Local email is written to the backend console. Configure SMTP before production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Remote Classroom <noreply@example.com>

# Optional AWS S3 storage (leave blank for local /media storage).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Free Render demo profile (set only for that deployment)
FREE_TIER_MODE=false
ENABLE_HLS_PROCESSING=true
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_QUERYSTRING_AUTH=true
